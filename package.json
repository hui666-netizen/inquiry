{
  "$schema": "https://json.schemastore.org/jsconfig",
  "name": "gotofreight-devops",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^16 || >=18"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "prepare": "husky install",
    "dev": "vite",
    "clean": "pnpm rimraf node_modules dist .turbo",
    "build": "pnpm run typecheck && pnpm run build:dev",
    "build-pre": "cross-env node --max-old-space-size=4096 node_modules/vite/bin/vite.js build ",
    "build:dev": "pnpm run build-pre --mode dev",
    "build:test": "pnpm run build-pre --mode test",
    "build:uat": "pnpm run build-pre --mode uat",
    "build:prod": "pnpm run build-pre --mode prod",
    "report": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx,.vue",
    "lint:style": "stylelint --fix  **/*.{css,less,scss.vue}",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
    "test:unit": "vitest ",
    "tsc": "vue-tsc --noEmit ",
    "typecheck": "node --max-old-space-size=4096 node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "reinstall": "rimraf node_modules && npm run bootstrap",
    "lint:lint-staged": "lint-staged",
    "openapi": "esno openapi/index.ts",
    "translate": "node openapi/translate.js --src=./src/i18n/lang/zh-CN/zh-CN.json --lang=en --dst=./src/i18n/lang/en/en.json"
  },
  "dependencies": {
    "@antv/g6": "^4.8.24",
    "@dagrejs/dagre": "^1.1.3",
    "@floating-ui/vue": "^1.0.6",
    "@micro-zoe/micro-app": "^1.0.0-rc.5",
    "@sjzy/calc": "^2.0.1",
    "@sjzy/editor": "^0.0.5",
    "@sjzy/extend": "^2.0.1",
    "@sjzy/hooks": "^2.0.1",
    "@sjzy/ui": "^2.5.20",
    "@sjzy/utils": "^2.0.11",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.39.1",
    "@vue-flow/node-toolbar": "^1.1.0",
    "@vue/repl": "^4.1.2",
    "@vueuse/components": "^10.9.0",
    "@vueuse/core": "^10.9.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.7.2",
    "core-js": "^3.35.0",
    "count-vue3": "^3.2.40",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "driver.js": "^1.3.1",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.4",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.0.0",
    "js-cookie": "^3.0.5",
    "jsencrypt": "^3.3.2",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.0",
    "monaco-editor": "^0.43.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "qs": "^6.11.2",
    "resize-detector": "^0.3.0",
    "sortablejs": "^1.15.0",
    "sqids": "^0.3.0",
    "vue": "^3.4.31",
    "vue-draggable-plus": "^0.5.3",
    "vue-hooks-plus": "2.2.0",
    "vue-i18n": "9.13.1",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.4.0",
    "vue-types": "5.1.2",
    "vuedraggable": "^4.1.0",
    "vxe-pc-ui": "^4.0.25",
    "vxe-table": "^4.7.28",
    "vxe-table-plugin-charts": "^4.0.2",
    "vxe-table-plugin-menus": "^4.0.5",
    "vxe-table-plugin-renderer": "^4.0.1",
    "xe-utils": "^3.5.27",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@iconify/vue": "^4.1.1",
    "@sjzy/eslint-config": "2.0.11",
    "@sjzy/openapi": "2.0.8",
    "@sjzy/ui": "^2.5.20",
    "@tinymce/tinymce-vue": "^5.1.1",
    "@types/crypto-js": "^4.2.2",
    "@types/dom-view-transitions": "^1.0.4",
    "@types/file-saver": "^2.0.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.14.4 ",
    "@types/nprogress": "^0.2.0",
    "@types/numeral": "^2.0.5",
    "@types/path-browserify": "^1.0.0",
    "@types/qs": "^6.9.7",
    "@types/sortablejs": "^1.15.2",
    "@unocss/eslint-config": "^0.61.0",
    "@unocss/preset-rem-to-px": "^0.61.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue-hooks-plus/resolvers": "^1.2.5",
    "@vue/test-utils": "^2.4.5",
    "code-inspector-plugin": "^0.13.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^9.5.0",
    "esno": "^4.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.38",
    "postcss-html": "^1.6.0",
    "postcss-import": "^16.0.1",
    "postcss-nesting": "^12.1.1",
    "postcss-preset-env": "^9.5.5",
    "postcss-scss": "^4.0.9",
    "postcss-syntax": "^0.36.2",
    "postcss-url": "^10.1.3",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.1.4",
    "rollup-plugin-external-globals": "^0.9.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.77.0",
    "stylelint": "^16.6.1",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.5.2",
    "unocss": "^0.61.0",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.3.1",
    "vite-plugin-compression2": "^1.1.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-inspect": "^0.8.4",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-mock": "^3.0.1",
    "vite-plugin-vue-devtools": "^7.3.0",
    "vitest": "^1.6.0",
    "vue-tsc": "2.0.24"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint:lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "!(package)*.json": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.{scss,less,styl,html}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
