{
  "i18n-ally.sourceLanguage": "zh-CN",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": "locales",
  "i18n-ally.sortKeys": true,
  "prettier.enable": true,
  "eslint.enable": true,
  "stylelint.enable": true,
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml"
  ],
  "stylelint.validate": ["css", "less", "postcss", "scss", "vue", "sass"],
  "stylelint.customSyntax": "postcss-html",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports": "never"
  },
  "files.associations": {
    "*.css": "css"
  },
  "editor.formatOnSave": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "prettier.endOfLine": "lf",
  "[javascript,vue,typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css,scss,sass,less]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "prettier.singleQuote": true,
  "vue.codeActions.enabled": true,
  "references.preferredLocation": "peek",
  "prettier.semi": false,
  "prettier.requireConfig": true,
  "autoimport.useSemiColon": false,
  "todo-tree.tree.disableCompactFolders": false,
  "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO"],
  "eslint.codeActionsOnSave.rules": null,
  "eslint.experimental.useFlatConfig": true,
  // Silent the stylistic rules in you IDE, but still auto fix them
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off"
    },
    {
      "rule": "*-indent",
      "severity": "off"
    },
    {
      "rule": "*-spacing",
      "severity": "off"
    },
    {
      "rule": "*-spaces",
      "severity": "off"
    },
    {
      "rule": "*-order",
      "severity": "off"
    },
    {
      "rule": "*-dangle",
      "severity": "off"
    },
    {
      "rule": "*-newline",
      "severity": "off"
    },
    {
      "rule": "*quotes",
      "severity": "off"
    },
    {
      "rule": "*semi",
      "severity": "off"
    }
  ],
  "vue-semantic-server.trace.server": "messages",
  "vue-syntactic-server.trace.server": "messages",
  // 函数注释
  "fileheader.cursorMode": {
    "description": "", // 函数注释生成之后，光标移动到这里
    "param": "", // param 开启函数参数自动提取 需要将光标放在函数行或者函数上方的空白行
    "return": ""
  },
  // 函数注释
  "fileheader.configObj": {
    "autoAdd": false // 不填加头部注释
  }
}
